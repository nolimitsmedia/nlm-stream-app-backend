# Never commit the real credential. On the gateway host this must match the
# backend's INGEST_GATEWAY_TOKEN value.
INGEST_GATEWAY_TOKEN=REPLACE_WITH_32_PLUS_CHARACTER_SECRET
NLM_BACKEND_URL=https://api.nolimitsmedia.com
GATEWAY_CONTROL_PORT=5092
GATEWAY_RESOLVE_TIMEOUT_MS=3000
GATEWAY_ROUTE_CACHE_TTL_MS=15000
GATEWAY_UPSTREAM_RTMP_PORT=1935

# Host-side public listener mappings for the SRS gateway container.
GATEWAY_RTMP_PORT=1935
GATEWAY_SRT_PORT=10080
